CONFIG_EBPFOS_MM_HOOK=y
CONFIG_EBPFOS_BLOCK_HOOK=y
CONFIG_EBPFOS_DRIVER_HOOK=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_EXT_GROUP_SCHED=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_LSM=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_DEVTMPFS=y
